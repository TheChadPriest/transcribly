# Copy to .env and adjust. Every setting is optional; defaults are shown.

# --- Storage ---
# TRANSCRIBLY_DATA_DIR=./data              # job database + temporary media (Docker: /data)
# TRANSCRIBLY_MODEL_DIR=                   # Whisper model cache (default <data_dir>/models; Docker: /models)
# TRANSCRIBLY_SECRET_KEY=                  # signs job access keys; generated and stored in the DB if unset

# --- Transcription ---
# TRANSCRIBLY_WHISPER_MODEL=small          # tiny | base | small | medium | large-v3
# TRANSCRIBLY_WHISPER_ALLOWED_MODELS=tiny,base,small,medium
# TRANSCRIBLY_WHISPER_DEVICE=auto          # auto | cpu | cuda
# TRANSCRIBLY_WHISPER_COMPUTE_TYPE=auto    # auto (int8 on CPU, float16 on GPU) | int8 | float16 | float32
# TRANSCRIBLY_WHISPER_CPU_THREADS=0        # 0 = CPU count / worker concurrency
# TRANSCRIBLY_CHUNK_SECONDS=600            # audio is processed (and checkpointed) in pieces this long

# --- Limits ---
# TRANSCRIBLY_MAX_UPLOAD_MB=1024
# TRANSCRIBLY_MAX_DURATION_SECONDS=21600   # 6 h; 0 = no limit
# TRANSCRIBLY_WORKER_CONCURRENCY=1         # simultaneous transcriptions
# TRANSCRIBLY_MAX_QUEUED_JOBS=20
# TRANSCRIBLY_JOBS_PER_IP_PER_HOUR=30      # 0 = no limit

# --- Retention & privacy ---
# TRANSCRIBLY_RESULT_RETENTION_HOURS=72
# TRANSCRIBLY_KEEP_MEDIA=false             # keep source media after processing (not recommended)
# TRANSCRIBLY_CACHE_RESULTS=true           # reuse transcripts of the same public URL

# --- AI study notes ---
# auto   = use a local Ollama model when it is running and has the model (default)
# ollama = same, but say so explicitly
# claude = send transcripts to Anthropic's API (best quality; costs money; needs ANTHROPIC_API_KEY in the
#          environment - never put the key in this file if it is committed anywhere)
# none   = no AI; study notes are assembled from transcript sentences
# TRANSCRIBLY_AI_PROVIDER=auto
# TRANSCRIBLY_OLLAMA_URL=http://127.0.0.1:11434     # Docker Compose: http://ollama:11434
# TRANSCRIBLY_OLLAMA_MODEL=qwen2.5:7b              # qwen2.5:3b is faster on weak machines; qwen2.5:14b is better with 16+ GB free RAM
# TRANSCRIBLY_OLLAMA_NUM_CTX=16384                 # longer videos are read in parts when they don't fit
# TRANSCRIBLY_CLAUDE_MODEL=claude-opus-5-5
# TRANSCRIBLY_CLAUDE_EFFORT=medium
# TRANSCRIBLY_AI_FACT_CHECK=auto                  # second checking pass: auto = Claude only; on | off

# --- HTTP ---
# TRANSCRIBLY_CORS_ORIGINS=http://localhost:3000   # only needed when the UI is hosted on another origin
# TRANSCRIBLY_TRUST_PROXY_HEADERS=false            # true behind a reverse proxy, for per-IP limits
# TRANSCRIBLY_FRONTEND_DIST=../frontend/out        # serve the built UI from the API
# TRANSCRIBLY_RUN_WORKER_IN_API=true               # false when running `python -m app.worker` separately
# TRANSCRIBLY_LOG_LEVEL=INFO
